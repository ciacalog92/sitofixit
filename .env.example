# ---------------------------------------------------------------------------
# Fixit Repair Express — variabili d'ambiente
# Copia in `.env.local` e compila i valori. Senza variabili → dati MOCK.
# ---------------------------------------------------------------------------

# Forza un driver specifico. Opzionale, auto-detect altrimenti.
# GESTIONALE_DRIVER=supabase   # "mock" | "supabase" | "repairdesk" | "rest"

# === SUPABASE (consigliato) ================================================
# Trovale su: supabase.com → progetto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...   # anon key (Settings → API)

# CONSIGLIATA: chiave service-role (server-only, mai esposta al browser).
# Bypassa le RLS della tabella riparazioni così il sito può
# leggere lo stato delle pratiche dei clienti in sicurezza.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Nomi tabelle (default usati se non impostati):
# SUPABASE_TICKETS_TABLE=tickets
# SUPABASE_REFURB_TABLE=ricondizionati

# Mapping colonne tabella TICKETS (modifica se i tuoi nomi differiscono):
# SUPABASE_TICKET_COL_CODE=codice
# SUPABASE_TICKET_COL_DEVICE=device
# SUPABASE_TICKET_COL_SERVICE=servizio
# SUPABASE_TICKET_COL_CUSTOMER=cliente
# SUPABASE_TICKET_COL_STATUS=stato
# SUPABASE_TICKET_COL_ETA=stima_ritiro
# SUPABASE_TICKET_COL_NOTES=note

# Mapping colonne tabella RICONDIZIONATI:
# SUPABASE_REFURB_COL_ID=id
# SUPABASE_REFURB_COL_BRAND=brand
# SUPABASE_REFURB_COL_MODEL=modello
# SUPABASE_REFURB_COL_STORAGE=storage
# SUPABASE_REFURB_COL_COLOR=colore
# SUPABASE_REFURB_COL_PRICE=prezzo
# SUPABASE_REFURB_COL_GRADE=grado
# SUPABASE_REFURB_COL_BATTERY=batteria
# SUPABASE_REFURB_COL_IMAGE=immagine_url
# SUPABASE_REFURB_COL_AVAIL=disponibile

# === REPAIRDESK (alternativa) ==============================================
# REPAIRDESK_API_KEY=la_tua_chiave_api
# REPAIRDESK_BASE_URL=https://api.repairdesk.co/api/web/v1

# === REST CUSTOM (qualsiasi gestionale con API HTTPS) =====================
# GESTIONALE_BASE_URL=https://api.tuogestionale.it/v1
# GESTIONALE_API_KEY=token_di_servizio
# GESTIONALE_TICKET_PATH=/tickets?ticket_no={code}
# GESTIONALE_REFURB_PATH=/inventory?type=refurbished

# === EMAIL — Resend (https://resend.com) ===================================
# Necessarie SOLO per inviare conferma e notifica per le prenotazioni.
# Senza queste, la prenotazione viene comunque salvata nel gestionale
# (tabella `prenotazioni`) ma nessuna mail viene spedita.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=Fixit Repair <prenotazioni@tuodominio.it>
# SHOP_NOTIFY_EMAIL=info@fixitrepair.it
